# ==============================================================================
# NEST.JS API Environment Variables (ejemplo)
# ==============================================================================
PORT=3333
JWT_SECRET="your_jwt_secret_here"

# Postgres (valores separados)
POSTGRES_USER=petrapp
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=petrapp_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ejemplo de URL combinada (opcional)
DATABASE_URL="postgres://petrapp:your_password_here@postgres:5432/petrapp_db?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Dynamic.xyz (reemplazar con valores reales)
DYNAMIC_API_KEY="your_dynamic_api_key"
DYNAMIC_ENVIRONMENT_ID="your_dynamic_env_id"
DYNAMIC_JWKS_URL="https://app.dynamic.xyz/.../.well-known/jwks"

# Pinata (IPFS)
PINATA_JWT="your_pinata_jwt"
PINATA_GATEWAY_URL="https://your-gateway.mypinata.cloud"

# Solana RPC
SOLANA_RPC_URL="https://api.devnet.solana.com"

NODE_ENV=development