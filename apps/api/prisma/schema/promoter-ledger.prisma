model PromoterLedger {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoterId    String   @map("promoter_id") @db.Uuid
  transactionId String?  @map("transaction_id") @db.Uuid
  ticketId      String?  @map("ticket_id") @db.Uuid
  eventId       String?  @map("event_id") @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("credits")
  entryType     String   @map("entry_type")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  promoter    Promoter     @relation(fields: [promoterId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  event       Event?       @relation(fields: [eventId], references: [id])

  @@map("promoter_ledgers")
}
