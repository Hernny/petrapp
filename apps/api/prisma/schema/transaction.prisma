model Transaction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  platformFeeAmount Decimal? @default(0.00) @map("platform_fee_amount") @db.Decimal(10, 2)
  promoterAmount    Decimal? @default(0.00) @map("promoter_amount") @db.Decimal(10, 2)
  currency          String
  paymentMethod     String   @map("payment_method")
  txSignature       String?  @unique @map("tx_signature")
  senderWallet      String?  @map("sender_wallet")
  status            String?  @default("pending")
  transactionTime   DateTime @default(now()) @map("transaction_time") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  promoterLedgers      PromoterLedger[]
  affiliateCommissions AffiliateCommission[]

  @@map("transactions")
}
