{
  "name": "blockchain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/blockchain/programs",
  "targets": {
    "build": {
      "executor": "@nx/workspace:run-commands",
      "options": {
        "command": "anchor build",
        "cwd": "apps/blockchain"
      }
    },
    "test": {
      "executor": "@nx/workspace:run-commands",
      "options": {
        "command": "anchor test",
        "cwd": "apps/blockchain"
      }
    }
  },
  "tags": ["type:app", "scope:blockchain"]
}
