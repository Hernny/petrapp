{
  "name": "ticketing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ticketing/programs",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "anchor build",
        "cwd": "apps/ticketing"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "anchor test",
        "cwd": "apps/ticketing"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "anchor deploy",
        "cwd": "apps/ticketing"
      }
    }
  },
  "tags": ["type:app", "scope:blockchain"]
}
