{
  "name": "@shared/database",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/shared/database/src",
  "targets": {
    "db-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e ../../../.env -- npx prisma migrate dev --schema=prisma/schema --config prisma/prisma.config.ts ",
        "cwd": "libs/shared/database"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e ../../../.env -- npx prisma generate --schema=prisma/schema --config prisma/prisma.config.ts",
        "cwd": "libs/shared/database"
      }
    },
    "db-reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e ../../../.env -- npx prisma migrate reset --force --schema=prisma/schema --config prisma/prisma.config.ts",
        "cwd": "libs/shared/database"
      }
    },
    "db-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e ../../../.env -- npx prisma studio --schema=prisma/schema --config prisma/prisma.config.ts",
        "cwd": "libs/shared/database"
      }
    }
  }
}
