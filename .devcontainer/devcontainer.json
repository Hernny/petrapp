{
  "name": "PetrApp Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",

  "forwardPorts": [3000, 3001, 3333, 5432, 6379, 5555],
  "portsAttributes": {
    "3000": { "label": "Web", "onAutoForward": "notify" },
    "3001": { "label": "Admin", "onAutoForward": "notify" },
    "3333": { "label": "API", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" },
    "5555": { "label": "Prisma Studio", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "nrwl.angular-console",
        "bradlc.vscode-tailwindcss",
        "jdinhlife.gruvbox",
        "eamodio.gitlens",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-docker",
        "prisma.prisma",
        "ms-ceintl.vscode-language-pack-es"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "prisma.showPrismaDataPlatformNotification": false
      }
    }
  },

  "postCreateCommand": "yarn install",
  "postStartCommand": "echo 'PetrApp Dev Container ready!'",

  "mounts": [
    "source=${localEnv:USERPROFILE}/.ssh,target=/root/.ssh,type=bind,consistency=cached"
  ]
}
